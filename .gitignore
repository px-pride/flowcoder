# Ignore everything by default
*

# Allow src/ directory and all its contents
!src/
!src/**

# But ignore __pycache__ everywhere
__pycache__/

# ...and build artifacts, which !src/** would otherwise un-ignore
*.egg-info/
build/
dist/

# Allow specific images in images/
!images/
!images/flowchart-example.png

# Allow root level files
!pyproject.toml
!README.md
!uv.lock
!LICENSE

# Allow .gitignore itself
!.gitignore

# Allow .github directory
!.github/
!.github/**

# Allow .python-version
!.python-version

# Allow package.json and package-lock.json for npm dependencies
!package.json
!package-lock.json

# Allow tests/ directory
!tests/
!tests/**

# Allow scripts/
!scripts/
!scripts/**

# Allow design_docs/
!design_docs/
!design_docs/**

# Allow progress-reports/
!progress-reports/
!progress-reports/**
